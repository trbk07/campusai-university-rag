  "recipe_source": "\"\"\"Score saved v5 retrieval; this recipe never runs retrieval or an LLM.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom evaluation.benchmarks.connected_groups import connected_groups\nfrom evaluation.common.metrics import evaluate_retrieval\nfrom evaluation.phase8 import run_product_baseline as r\nfrom evaluation.phase8.run_retrieval_baseline import grouped_ci, split_metrics\n\nm, packet = r.read(r.MANIFEST), r.read(r.PREFLIGHT)\nr.verify_inputs(m, packet)\nrows = [json.loads(line) for line in (r.ROOT / r.OUT).read_text(encoding=\"utf-8\").splitlines()]\nassert [c[\"qid\"] for c in packet[\"cases\"]] == [row[\"qid\"] for row in rows]\nassert all(bool(row[\"gold_evidence\"]) == row[\"answerable\"] for row in rows)\noutputs = {c[\"qid\"]: c[\"retrieved_evidence\"] for c in packet[\"cases\"]}\nquality = evaluate_retrieval(rows, lambda row: outputs[row[\"qid\"]], k_values=(1, 3, 5))\nper_query = {row[\"qid\"]: row for row in quality[\"per_query\"]}\n# Independent doc/chunk-pair check, stricter than the shared scorer's chunk match.\nfor row in rows:\n    gold = {(e[\"doc_id\"], e[\"chunk_id\"]) for e in row[\"gold_evidence\"]}\n    ranks = [i + 1 for i, e in enumerate(outputs[row[\"qid\"]]) if (e[\"doc_id\"], e[\"chunk_id\"]) in gold]\n    assert per_query[row[\"qid\"]][\"mrr\"] == (1 / min(ranks) if ranks else 0)\n    for k in (1, 3, 5):\n        assert per_query[row[\"qid\"]][\"recall\"][str(k)] == float(bool(ranks) and min(ranks) <= k)\n\ngroups = connected_groups(rows)\npositive = [row for row in rows if row[\"answerable\"]]\nnegative = [row for row in rows if not row[\"answerable\"]]\nmetrics = {}\nfor k in (1, 3, 5):\n    values = {row[\"qid\"]: per_query[row[\"qid\"]][\"recall\"][str(k)] for row in positive}\n    metrics[f\"answerable_recall_at_{k}\"] = {\n        \"numerator\": sum(values.values()), \"denominator\": len(values),\n        \"value\": sum(values.values()) / len(values), \"population\": \"answerable benchmark rows\",\n        \"aggregation\": \"micro fraction with any gold doc/chunk in the first k results\",\n        \"ci95\": grouped_ci(values, groups)}\nvalues = {row[\"qid\"]: per_query[row[\"qid\"]][\"mrr\"] for row in positive}\nmetrics[\"answerable_mrr\"] = {\"numerator\": sum(values.values()), \"denominator\": len(values),\n    \"value\": sum(values.values()) / len(values), \"population\": \"answerable benchmark rows\",\n    \"aggregation\": \"micro mean reciprocal rank of first gold doc/chunk\", \"ci95\": grouped_ci(values, groups)}\nvalues = {row[\"qid\"]: float(bool(outputs[row[\"qid\"]])) for row in negative}\nmetrics[\"unanswerable_retrieval_false_positive_rate\"] = {\n    \"numerator\": sum(values.values()), \"denominator\": len(values), \"value\": sum(values.values()) / len(values),\n    \"population\": \"unanswerable benchmark rows\", \"aggregation\": \"micro fraction with nonempty retrieval\",\n    \"ci95\": grouped_ci(values, groups)}\n# The shared split helper additionally expects Recall@10.\nsplit_quality = evaluate_retrieval(rows, lambda row: outputs[row[\"qid\"]], k_values=(1, 3, 5, 10))\nrecipe = Path(__file__).read_text(encoding=\"utf-8\")\nreport = {\"schema_version\": 1, \"phase\": 8, \"status\": \"SAVED_PREFLIGHT_RETRIEVAL_SCORED_NOT_PRODUCT_ACCEPTANCE\",\n    \"provider_requests_by_this_computation\": 0, \"gate_eligible\": False, \"fresh_validation\": False,\n    \"benchmark\": packet[\"benchmark\"], \"preflight\": {\"path\": r.PREFLIGHT.as_posix(), \"sha256\": r.sha256(r.ROOT / r.PREFLIGHT)},\n    \"freeze\": {\"path\": r.FREEZE.as_posix(), \"sha256\": r.sha256(r.ROOT / r.FREEZE)},\n    \"source_identity\": packet[\"source_identity\"], \"index\": packet[\"index\"], \"metrics\": metrics,\n    \"split_metrics\": split_metrics(rows, outputs, {x[\"qid\"]: x for x in split_quality[\"per_query\"]}, groups),\n    \"cross_check\": {\"doc_chunk_pair_checks\": len(rows), \"status\": \"PASS\"},\n    \"limitations\": [\"Saved actual retrieval from zero-egress product preflight; no new inference was performed.\",\n        \"Synthetic provider-failure responses are excluded; product answer/citation/grounding baseline is still missing.\",\n        \"No product end-to-end latency/resource claim is derived from preflight timings.\"],\n    \"recipe_source\": recipe, \"recipe_sha256\": hashlib.sha256(recipe.encode()).hexdigest()}\ntarget = r.ROOT / \"evaluation/results/phase8-product-preflight-retrieval-v5.json\"\nif target.exists():\n    assert json.loads(target.read_text(encoding=\"utf-8\")) == report, \"saved report does not reproduce\"\nelse:\n    with target.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n        json.dump(report, stream, ensure_ascii=False, indent=2)\n        stream.write(\"\\n\")\nprint(json.dumps({\"status\": report[\"status\"], \"metrics\": metrics, \"cross_check\": report[\"cross_check\"]}, indent=2))\n",
  "recipe_sha256": "a15330df0a72c5e14d8dccf3311be3b76e31b9199531ea26dcc855dab95cc658"
