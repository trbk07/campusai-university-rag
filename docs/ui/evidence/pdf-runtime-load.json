  "historical_ocr_probe_source": "import hashlib,json,sys,threading,time\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport psutil\nimport rapidocr_onnxruntime as rapid\nfrom campusai.ingestion.ocr import ocr_pdf\nmode=sys.argv[1]\noriginal=rapid.RapidOCR\nif mode=='bounded':\n rapid.RapidOCR=lambda: original(intra_op_num_threads=1,inter_op_num_threads=1)\nstop=threading.Event(); counts=[]; rss=[]; proc=psutil.Process()\ndef sample():\n while not stop.wait(.02): counts.append(proc.num_threads()); rss.append(proc.memory_info().rss)\nsampler=threading.Thread(target=sample); sampler.start()\npaths=[Path('data/corpus/university')/n for n in ['uet_admission_2024.pdf','uet_admission_2025.pdf','uet_computer_engineering_program.pdf']]\nstarted=time.perf_counter()\ndef recognize(path):\n result=ocr_pdf(path,page_numbers=[1],max_pages=1,timeout_seconds=120)\n return {'name':path.name,'text_sha256':hashlib.sha256(result.pages[0]['text'].encode()).hexdigest(),'characters':len(result.pages[0]['text']),'confidence':result.average_confidence,'seconds':result.elapsed_seconds}\ntry:\n with ThreadPoolExecutor(max_workers=3) as pool: results=list(pool.map(recognize,paths))\n seconds=time.perf_counter()-started\nfinally: stop.set(); sampler.join()\nreport={'mode':mode,'workers':3,'seconds':seconds,'peak_threads':max(counts),'peak_sampled_rss_bytes':max(rss),'results':results}\nPath('.tmp/qa-ocr-thread-'+mode+'.json').write_text(json.dumps(report,indent=2))\nprint(json.dumps(report),flush=True)\n"
