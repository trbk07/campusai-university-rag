GEMINI_API_KEY=
# Optional: three independent Google projects, only with free_multi_project.yaml.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY=

# Local app: existing environment values take priority over this file.
CAMPUSAI_LLM_CONFIG=configs/free_llm.yaml
# Validated, source/version-scoped answers survive local app restarts.
# Use :memory: to retain no answer bodies after process exit.
# Default state: %LOCALAPPDATA%\CampusAI. Set an absolute path to override.
# Existing users: set this to the old project root to retain data/store and quota.
# CAMPUSAI_STATE_ROOT=D:\CampusAI Data
# Relative overrides resolve under CAMPUSAI_STATE_ROOT.
# CAMPUSAI_RAG_CACHE_PATH=data/cache/grounded-answers.sqlite3
# Bound PDF ingestion and parallel read-only question handling on the local app.
CAMPUSAI_INGESTION_WORKERS=3
CAMPUSAI_INGESTION_PENDING=8
CAMPUSAI_QUERY_WORKERS=4
CAMPUSAI_KEY_FILE=configs/key.yaml
# Explicitly select one credential; no automatic key rotation.
CAMPUSAI_KEY_NAME=key_1

# Optional reranker. Fill verified local identity after the release gates.
RERANKER_ENABLED=false
RERANKER_DEPLOYMENT=experimental
RERANKER_MODE=hard_only
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=
RERANKER_MODEL_SHA256=
RERANKER_TOKENIZER_REVISION=
RERANKER_MODEL_DIR=
RERANKER_DEVICE=cpu
RERANKER_CALIBRATION=evaluation/results/reranker_score_calibration.json
RERANKER_RELEASE_MANIFEST=.release/reranker/release_manifest.json
RERANKER_CANDIDATE_CAP=40
RERANKER_TIMEOUT_MS=1000
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_DTYPE=float32
# Optional microbatching: bind these settings in M3/M5 before activation.
RERANKER_BATCH_WINDOW_MS=0
RERANKER_MAX_BATCH_PAIRS=200
# Measurements always force this to zero. Cached ranks are never reused.
RERANKER_SCORE_CACHE_SIZE=0
RERANKER_QUEUE_LIMIT=2
RERANKER_WARMUP=true
