GEMINI_API_KEY=
GROQ_API_KEY=

# Optional reranker. Fill verified local identity after the release gates.
RERANKER_ENABLED=false
RERANKER_DEPLOYMENT=experimental
RERANKER_MODE=hard_only
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=
RERANKER_MODEL_SHA256=
RERANKER_TOKENIZER_REVISION=
RERANKER_MODEL_DIR=
RERANKER_DEVICE=cpu
RERANKER_CALIBRATION=evaluation/results/reranker_score_calibration.json
RERANKER_RELEASE_MANIFEST=.release/reranker/release_manifest.json
RERANKER_CANDIDATE_CAP=40
RERANKER_TIMEOUT_MS=1000
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_DTYPE=float32
# Optional microbatching: bind these settings in M3/M5 before activation.
RERANKER_BATCH_WINDOW_MS=0
RERANKER_MAX_BATCH_PAIRS=200
# Measurements always force this to zero. Cached ranks are never reused.
RERANKER_SCORE_CACHE_SIZE=0
RERANKER_QUEUE_LIMIT=2
RERANKER_WARMUP=true
